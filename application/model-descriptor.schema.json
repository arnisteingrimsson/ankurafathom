          "not": {
            "anyOf": [
              {
                "required": [
                  "minimum"
                ]
              },
              {
                "required": [
                  "maximum"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "minimum",
            "maximum"
          ],
          "not": {
            "required": [
              "choices"
            ]
          }
        }
      ]
