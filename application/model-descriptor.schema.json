    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string"
        },
        "time": {
          "type": "number"
        },
        "value": {
          "type": "number"
        },
        "scenario": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "replication": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "metric",
        "time",
        "value",
        "scenario",
        "replication",
        "dimensions"
      ]
    },
    "Results": {
      "type": "object",
      "required": [
        "rows",
        "provenance",
        "next_offset",
        "downsampling",
        "authoritative_for_aggregation"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Observation"
          }
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source_rows": {
          "type": "integer"
        },
        "total_rows": {
          "type": "integer"
        },
        "downsampling": {
          "type": "string"
        },
        "authoritative_for_aggregation": {
          "type": "boolean",
          "const": false
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "Interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "number"
