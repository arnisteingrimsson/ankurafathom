    "CompareRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline_run": {
          "type": "string"
        },
        "candidate_run": {
          "type": "string"
        },
        "baseline_scenario": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "candidate_scenario": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "replication": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
