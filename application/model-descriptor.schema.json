      "properties": {
        "id": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "number",
                  "integer",
                  "boolean"
                ]
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "choices": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "number"
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "synthetic",
                  "calibrated",
                  "agreed",
                  "unspecified"
                ]
              },
              "source": {
                "type": "string"
              },
              "default": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label",
              "description",
              "kind",
              "status",
              "source"
            ],
            "oneOf": [
              {
                "required": [
                  "choices"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "minimum"
                      ]
                    },
                    {
                      "required": [
                        "maximum"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "minimum",
                  "maximum"
                ],
                "not": {
                  "required": [
                    "choices"
                  ]
                }
              }
            ]
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Metric"
          }
        },
        "capabilities": {
          "type": "object"
        },
        "time": {
          "type": "object"
        },
        "input_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
