      },
      "required": [
        "metric",
        "value",
        "unit",
        "aggregation",
        "reason",
        "dimensions",
        "interval"
      ]
    },
    "ThresholdResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "gte",
            "lte"
          ]
        },
        "value": {
          "type": "number"
        },
        "observed": {
          "type": [
            "number",
            "null"
          ]
        },
        "passed": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "metric",
        "operator",
        "value",
        "observed",
        "passed"
      ]
    },
    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "replication": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MetricValue"
          }
        },
        "thresholds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThresholdResult"
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "calculation_version": {
          "type": "string"
        },
        "data_resolution": {
          "type": "string",
          "const": "full"
        }
      },
      "required": [
        "scenario",
        "replication",
        "values",
        "thresholds",
        "provenance",
        "calculation_version",
        "data_resolution"
      ]
    },
    "ComparisonValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string"
        },
        "baseline": {
          "type": [
            "number",
            "null"
          ]
        },
        "candidate": {
          "type": [
            "number",
            "null"
          ]
        },
        "delta": {
          "type": [
            "number",
            "null"
          ]
        },
        "percent_change": {
          "type": [
            "number",
            "null"
          ]
        },
        "percent_convention": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "metric",
        "baseline",
        "candidate",
        "delta",
        "percent_change",
        "percent_convention",
        "reason",
        "unit",
        "dimensions"
      ]
    },
    "ValuationResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string"
        },
        "annual_discount_rate": {
          "type": "number",
          "exclusiveMinimum": -1
        },
        "time_units_per_year": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "initial_incremental_cash_flow": {
          "type": "number"
        },
        "incremental_npv": {
          "type": "number"
        },
        "undiscounted_payback_time": {
          "type": [
            "number",
            "null"
          ]
        },
        "payback_status": {
          "type": "string",
          "enum": [
            "recovered",
            "not_recovered",
            "no_deficit"
          ]
        },
        "convention": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "metric",
        "annual_discount_rate",
        "time_units_per_year",
        "initial_incremental_cash_flow",
        "incremental_npv",
        "undiscounted_payback_time",
        "payback_status",
        "convention",
        "unit"
      ]
