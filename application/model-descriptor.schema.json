        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "id",
        "overrides"
      ]
    },
    "RunRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/Scenario"
          }
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "replications": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "require_check": {
          "type": "boolean"
        }
      },
      "required": [
        "model_id",
        "model_version"
      ],
      "not": {
        "required": [
          "overrides",
          "scenarios"
        ]
      }
    },
    "Threshold": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "gte",
            "lte"
          ]
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "metric",
        "operator",
        "value"
      ]
    },
    "SummaryRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "scenario": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "replication": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
