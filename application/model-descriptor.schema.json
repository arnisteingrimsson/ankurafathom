        },
        "baseline_provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "candidate_provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "calculation_version": {
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/Interval"
