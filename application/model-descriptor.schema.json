        "stage": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cache_hit": {
          "type": "boolean"
        }
      }
    },
    "Parameter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "number",
            "integer",
            "boolean"
          ]
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "synthetic",
            "calibrated",
            "agreed",
            "unspecified"
