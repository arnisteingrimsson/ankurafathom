    "Metric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "number",
            "integer",
            "currency",
            "percent"
          ]
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "aggregation": {
          "type": "string",
          "enum": [
            "last",
            "sum",
            "delta",
            "integral",
            "mean",
            "ratio",
            "sum_metrics"
          ]
        },
        "output": {
          "type": "string"
        },
        "numerator": {
          "type": "string"
        },
        "denominator": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interpolation": {
          "type": "string",
          "enum": [
            "hold",
            "linear"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "definition",
        "unit",
        "format",
        "dimensions",
        "aggregation"
      ]
