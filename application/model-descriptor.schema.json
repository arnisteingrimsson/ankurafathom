          "type": "array",
          "items": {
            "$ref": "#/$defs/Threshold"
          }
        }
      },
      "required": [
        "metrics",
        "from",
        "to"
      ]
    },
    "Valuation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string"
        },
        "annual_discount_rate": {
          "type": "number",
          "exclusiveMinimum": -1
