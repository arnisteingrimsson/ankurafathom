    "Progress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "execution_stages"
        },
        "completed_trajectories": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
