    "ExplainRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string"
        },
        "at": {
          "type": "number"
        },
        "from": {
          "type": "number"
        },
        "scenario": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "replication": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "metric",
        "at"
      ]
    },
