              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "value": {
                "type": "number"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "parameters",
              "value",
              "message"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "id",
        "label",
        "description",
        "parameters",
        "metrics"
      ]
