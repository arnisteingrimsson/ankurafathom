<xmile xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" version="1.0">
<header><name>Fathom lookup conformance</name></header>
<sim_specs method="Euler"><start>0</start><stop>4</stop><dt>0.25</dt></sim_specs>
<model><variables>
<gf name="curve"><xpts>1,2,3</xpts><ypts>1,3,5</ypts></gf>
<stock name="clamped"><eqn>0</eqn><inflow>clamp_flow</inflow></stock>
<flow name="clamp_flow"><eqn>curve(TIME)</eqn></flow>
<gf name="linear_curve" type="extrapolate"><xscale min="1" max="3"/><ypts>1,3,5</ypts></gf>
<stock name="extrapolated"><eqn>0</eqn><inflow>linear_flow</inflow></stock>
<flow name="linear_flow"><eqn>linear_curve(TIME)</eqn></flow>
<stock name="composition"><eqn>0</eqn><inflow>composed_flow</inflow></stock>
<flow name="composed_flow"><eqn>curve(curve(TIME)/2)</eqn></flow>
</variables></model></xmile>
