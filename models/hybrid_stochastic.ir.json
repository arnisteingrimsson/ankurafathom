{
  "ir_version": "0.1",
  "name": "stochastic_completion_stock",
  "mode": "hybrid",
  "time": { "unit": "day", "dt": 1, "horizon": 60 },
  "sd": {
    "components": [
      { "id": "finished_stock", "kind": "stock", "init": 0, "unit": "engagement" }
    ]
  },
  "des": {
    "components": [
      { "id": "arrivals", "kind": "source", "exponential": {
        "count": 30,
        "arrival_rate": 1.2,
        "service_rate": 2.0,
        "start": 0,
        "first_id": 100,
        "stream": 12
      } },
      { "id": "delivery", "kind": "server", "capacity": 2 },
      { "id": "done", "kind": "sink" }
    ],
    "links": [
      { "from": "arrivals", "to": "delivery" },
      { "from": "delivery", "to": "done" }
    ]
  },
  "bridges": [
    { "kind": "completion_to_stock", "from": "done", "to": "finished_stock",
      "amount": 1, "unit": "engagement" }
  ],
  "outputs": [
    { "id": "stock", "stock": "finished_stock" },
    { "id": "completed", "component": "done", "metric": "completed" },
    { "id": "emitted", "component": "arrivals", "metric": "emitted" }
  ]
}
