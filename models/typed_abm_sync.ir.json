{
  "ir_version":"0.1", "name":"Typed synchronous workload", "mode":"abm",
  "time":{"unit":"day","dt":0.5,"horizon":2},
  "parameters":[{"id":"gain","value":2,"unit":"1"}],
  "components":[{
    "id":"people","kind":"population","execution":"sync",
    "fields":[{"name":"work","type":"integer","unit":"1"},{"name":"ready","type":"boolean","unit":"1"},{"name":"role","type":"string","unit":"1"}],
    "agents":[{"work":1,"ready":true,"role":"analyst"},{"work":3,"ready":false,"role":"partner"}],
    "phases":[{"assign":[{"field":"work","expr":"work + gain"},{"field":"ready","expr":"1-ready"}]},{"assign":[{"field":"work","expr":"work*2"}]}]
  }],
  "outputs":[{"id":"first","agent":0,"field":"work"},{"id":"ready","agent":0,"field":"ready"},{"id":"total","metric":"sum","field":"work"},{"id":"active","metric":"active"}]
}
