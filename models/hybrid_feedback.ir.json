{
  "ir_version": "0.1",
  "name": "completion_feedback",
  "mode": "hybrid",
  "time": { "unit": "day", "dt": 1, "horizon": 4 },
  "sd": {
    "components": [
      { "id": "finished_stock", "kind": "stock", "init": 0, "unit": "engagement" }
    ]
  },
  "des": {
    "components": [
      { "id": "arrivals", "kind": "source", "schedule": [
        { "id": 1, "arrival": 0, "service": 1 }
      ] },
      { "id": "delivery", "kind": "server", "capacity": 1 },
      { "id": "done", "kind": "sink" }
    ],
    "links": [
      { "from": "arrivals", "to": "delivery" },
      { "from": "delivery", "to": "done" }
    ]
  },
  "bridges": [
    { "kind": "completion_to_stock", "from": "done", "to": "finished_stock",
      "amount": 1, "unit": "engagement" },
    { "kind": "stock_to_arrival", "from": "finished_stock", "to": "delivery",
      "threshold": 1, "unit": "engagement", "service": 1,
      "first_id": 100, "max_count": 2 }
  ],
  "outputs": [
    { "id": "stock", "stock": "finished_stock" },
    { "id": "accepted", "component": "delivery", "metric": "accepted" },
    { "id": "completed", "component": "done", "metric": "completed" }
  ]
}
