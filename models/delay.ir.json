{
  "ir_version": "0.1",
  "name": "delayed_delivery",
  "time": { "unit": "day", "dt": 1, "horizon": 4 },
  "parameters": [ { "id": "intake", "value": 10, "unit": "kg/day" } ],
  "components": [
    { "id": "delivered", "kind": "stock", "init": 0, "unit": "kg" },
    { "id": "queue", "kind": "delay", "type": "material", "order": 1,
      "duration": 2, "initial": 0, "input": "intake", "unit": "kg/day" },
    { "id": "completion", "kind": "flow", "source": null, "destination": "delivered",
      "expr": "queue", "unit": "kg/day" }
  ],
  "outputs": [
    { "id": "delivered_ts", "stock": "delivered" },
    { "id": "queue_out", "component": "queue" }
  ]
}
