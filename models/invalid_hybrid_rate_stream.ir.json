{
  "ir_version": "0.1",
  "name": "invalid_rate_stream_overlap",
  "mode": "hybrid",
  "time": { "unit": "day", "dt": 1, "horizon": 2 },
  "sd": { "components": [
    { "id": "signal", "kind": "stock", "init": 1, "unit": "engagement" }
  ] },
  "des": {
    "components": [
      { "id": "arrivals", "kind": "source", "exponential": {
        "count": 1, "arrival_rate": 1, "service_rate": 1,
        "start": 0, "first_id": 100, "stream": 12
      } },
      { "id": "delivery", "kind": "server", "capacity": 1 },
      { "id": "done", "kind": "sink" }
    ],
    "links": [
      { "from": "arrivals", "to": "delivery" },
      { "from": "delivery", "to": "done" }
    ]
  },
  "bridges": [
    { "kind": "completion_to_stock", "from": "done", "to": "signal",
      "amount": 1, "unit": "engagement" },
    { "kind": "stock_to_rate", "from": "signal", "to": "delivery",
      "base_rate": 0, "gain": 1,
      "rate_unit": "1/day", "gain_unit": "1/day/engagement",
      "service_rate": 1, "service_rate_unit": "1/day",
      "first_id": 200, "max_count": 1, "stream": 13 }
  ],
  "outputs": [ { "id": "stock", "stock": "signal" } ]
}
