{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ankurafathom.local/schema/manifest/0.3",
  "title": "AnkuraFathom file and in-memory run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "created_utc",
    "inputs",
    "result",
    "output",
    "validation"
  ],
  "properties": {
    "manifest_version": {
      "enum": [
        "0.1",
        "0.2",
        "0.3"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "experiment",
        "data",
        "scenarios",
        "replications",
        "execution"
      ],
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "file_sha256",
            "canonical_sha256",
            "canonical_json"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "file_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "canonical_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "canonical_json": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "experiment": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "file_sha256",
                "canonical_sha256",
                "canonical_json"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "file_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "canonical_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "canonical_json": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "binding",
              "path",
              "file_sha256",
              "canonical_sha256"
            ],
            "properties": {
              "binding": {
                "type": "object"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "file_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "canonical_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "overrides",
              "effective_parameters"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "overrides": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "effective_parameters": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              }
            }
          }
        },
        "replications": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seed",
            "threads",
            "backend",
            "precision",
            "build"
          ],
          "properties": {
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "threads": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "backend": {
              "const": "cpu-reference"
            },
            "precision": {
              "const": "binary64;ffp-contract=off;no-fast-math;ordered-observations-v1"
            },
            "build": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "source_sha256",
                "git_commit",
                "compiler",
                "build_type",
                "configured_system",
                "compiler_flags",
                "sanitizers",
                "arrow",
                "system",
                "release",
                "machine",
                "pointer_bits",
                "double_bits",
                "byte_order",
                "stdlib",
                "stdlib_version"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "git_commit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "compiler": {
                  "type": "string",
                  "minLength": 1
                },
                "build_type": {
                  "type": "string"
                },
                "configured_system": {
                  "type": "string",
                  "minLength": 1
                },
                "compiler_flags": {
                  "type": "string"
                },
                "sanitizers": {
                  "type": "string",
                  "minLength": 1
                },
                "arrow": {
                  "type": "string",
                  "minLength": 1
                },
                "system": {
                  "type": "string",
                  "minLength": 1
                },
                "release": {
                  "type": "string",
                  "minLength": 1
                },
                "machine": {
                  "type": "string",
                  "minLength": 1
                },
                "pointer_bits": {
                  "type": "integer",
                  "minimum": 0
                },
                "double_bits": {
                  "const": 64
                },
                "byte_order": {
                  "enum": [
                    "little",
                    "big"
                  ]
                },
                "stdlib": {
                  "type": "string",
                  "minLength": 1
                },
                "stdlib_version": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "sha256",
        "trajectories",
        "rows"
      ],
      "properties": {
        "encoding": {
          "const": "ordered-ieee754-le-v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "trajectories": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "format": {
          "enum": [
            "csv",
            "parquet",
            "arrow",
            "memory"
          ]
        },
        "schema_version": {
          "const": "0.2"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "execution",
        "accuracy"
      ],
      "properties": {
        "model": {
          "const": "pass"
        },
        "execution": {
          "const": "pass"
        },
        "accuracy": {
          "const": "not_assessed"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "manifest_version": {
            "enum": [
              "0.2",
              "0.3"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "output": {
            "required": [
              "schema_version"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "output": {
            "not": {
              "required": [
                "schema_version"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "manifest_version": {
            "const": "0.3"
          }
        }
      },
      "then": {
        "properties": {
          "output": {
            "properties": {
              "path": {
                "const": ""
              },
              "format": {
                "const": "memory"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "inputs": {
            "properties": {
              "model": {
                "properties": {
                  "path": {
                    "minLength": 1
                  }
                }
              },
              "experiment": {
                "if": {
                  "type": "object"
                },
                "then": {
                  "properties": {
                    "path": {
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "output": {
            "properties": {
              "path": {
                "minLength": 1
              },
              "format": {
                "enum": [
                  "csv",
                  "parquet",
                  "arrow"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
